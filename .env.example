# Supabase (required for orders to sync between customer site and admin)
# 1. Create a project at https://supabase.com
# 2. Go to Settings → API in the left sidebar
# 3. Copy:
#    - Project URL
#    - The Publishable key (new)  OR  the anon public key (legacy)
#
# For client-side (Next.js), use the publishable or anon key. Never use service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Preferred (new format):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Or legacy:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# After adding these, restart: npm run dev
# Then run supabase_schema.sql in Supabase SQL Editor once.
# First admin bootstrap is completed from /admin/login.
# If email confirmation is enabled in Supabase Auth, confirm the email,
# sign in, then use the "إنشاء / إكمال أول أدمن" tab to finish linking.

# Optional but recommended for creating additional admin accounts
# from inside the dashboard. Server-side only: never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

