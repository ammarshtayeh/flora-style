# Supabase (required for orders to sync between customer site and admin)
# 1. Create a project at https://supabase.com
# 2. Go to Settings → API in the left sidebar
# 3. Copy:
#    - Project URL
#    - The Publishable key (new)  OR  the anon public key (legacy)
#
# For client-side (Next.js), use the publishable or anon key. Never use service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Preferred (new format):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Or legacy:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# After adding these, restart: npm run dev
# Then run supabase_schema.sql in Supabase SQL Editor once.
