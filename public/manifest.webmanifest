{
  "name": "Flora Style Online Store",
  "short_name": "Flora Style",
  "id": "/",
  "description": "Luxury bilingual fashion shopping experience.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "lang": "ar",
  "dir": "rtl",
  "background_color": "#0b0b0a",
  "theme_color": "#0b0b0a",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Shop",
      "short_name": "Shop",
      "url": "/shop"
    },
    {
      "name": "Admin",
      "short_name": "Admin",
      "url": "/admin"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
